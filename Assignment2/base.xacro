<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="robot_base"
                 params="base_radius base_height">

        <link name="base_link">
            <visual>
                <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
                <geometry>
                    <cylinder radius="${base_radius}"
                               length="${base_height}"/>
                </geometry>
                <material name="blue">
                    <color rgba="0.1 0.2 0.8 1"/>
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 ${base_height/2}"/>
                <geometry>
                    <cylinder radius="${base_radius}"
                               length="${base_height}"/>
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0 0 ${base_height/2}"/>
                <mass value="10.0"/>
                <inertia ixx="0.1" ixy="0" ixz="0"
                         iyy="0.1" iyz="0" izz="0.1"/>
            </inertial>
        </link>

    </xacro:macro>

</robot>
