<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="robot_arm"
               params="base_height link1_length link2_length">

    <joint name="base_yaw_joint" type="revolute">
        <parent link="base_link"/>
        <child link="base_rotor"/>
        <origin xyz="0 0 ${base_height}" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-3.14"
               upper="3.14"
               effort="100"
               velocity="1.0"/>
    </joint>

    <link name="base_rotor">
        <visual>
            <geometry>
                <cylinder radius="0.12" length="0.08"/>
            </geometry>
            <material name="blue">
                <color rgba="0.1 0.2 0.8 1"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.12" length="0.08"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="2.0"/>
            <inertia ixx="0.01" ixy="0" ixz="0"
                     iyy="0.01" iyz="0" izz="0.01"/>
        </inertial>
    </link>

    <joint name="base_pitch_joint" type="revolute">
        <parent link="base_rotor"/>
        <child link="link1"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-3.14"
               upper="0"
               effort="100"
               velocity="1.0"/>
    </joint>

    <link name="link1">
        <visual>
            <origin xyz="${link1_length/2} 0 0"/>
            <geometry>
                <box size="${link1_length} 0.06 0.06"/>
            </geometry>
            <material name="orange">
                <color rgba="1 0.4 0.1 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="${link1_length/2} 0 0"/>
            <geometry>
                <box size="${link1_length} 0.06 0.06"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="${link1_length/2} 0 0"/>
            <mass value="3.0"/>
            <inertia ixx="0.01" ixy="0" ixz="0"
                     iyy="0.1" iyz="0" izz="0.1"/>
        </inertial>
    </link>

    <joint name="elbow_joint" type="revolute">
        <parent link="link1"/>
        <child link="link2"/>
        <origin xyz="${link1_length} 0 0"
                rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-3.14"
               upper="3.14"
               effort="80"
               velocity="1.0"/>
    </joint>
    
    <link name="link2">
        <visual>
            <origin xyz="${link2_length/2} 0 0"/>
            <geometry>
                <box size="${link2_length} 0.05 0.05"/>
            </geometry>
            <material name="yellow">
                <color rgba="1 0.8 0.1 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="${link2_length/2} 0 0"/>
            <geometry>
                <box size="${link2_length} 0.05 0.05"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="${link2_length/2} 0 0"/>
            <mass value="2.0"/>
            <inertia ixx="0.01" ixy="0" ixz="0"
                     iyy="0.08" iyz="0" izz="0.08"/>
        </inertial>
    </link>

    <joint name="wrist_joint" type="revolute">
        <parent link="link2"/>
        <child link="wrist_link"/>
        <origin xyz="${link2_length} 0 0"
                rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-1.57"
               upper="1.57"
               effort="30"
               velocity="1.0"/>
    </joint>
    
    <link name="wrist_link">
        <visual>
            <geometry>
                <box size="0.08 0.06 0.06"/>
            </geometry>
            <material name="gray">
                <color rgba="0.3 0.3 0.3 1"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="0.08 0.06 0.06"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.5"/>
            <inertia ixx="0.001" ixy="0" ixz="0"
                     iyy="0.001" iyz="0" izz="0.001"/>
        </inertial>
    </link>

  </xacro:macro>

</robot>
