<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="robot_gripper"
                 params="parent gripper_span">
                 
        <joint name="gripper_mount" type="fixed">
            <parent link="${parent}"/>
            <child link="gripper_palm"/>
            <origin xyz="0 0 0"/>
        </joint>
        
        <link name="gripper_palm">
            <visual>
                <origin xyz="0.03 0 0"/>
                <geometry>
                    <box size="0.06 0.2 0.04"/>
                </geometry>
                <material name="black">
                    <color rgba="0.1 0.1 0.1 1"/>
                </material>
            </visual>
            <collision>
                <origin xyz="0.03 0 0"/>
                <geometry>
                    <box size="0.06 0.2 0.04"/>
                </geometry>
            </collision>
            <inertial>
                <mass value="0.5"/>
                <inertia ixx="0.001" ixy="0" ixz="0"
                         iyy="0.001" iyz="0" izz="0.001"/>
            </inertial>
        </link>
        
        <joint name="left_finger_joint" type="prismatic">
            <parent link="gripper_palm"/>
            <child link="left_finger"/>
            <origin xyz="0.06 0.01 0"/>
            <axis xyz="0 1 0"/>
            <limit lower="0"
                   upper="${(gripper_span - 0.02)/2}"
                   effort="20"
                   velocity="0.1"/>
        </joint>

        <link name="left_finger">
            <visual>
                <geometry>
                    <box size="0.12 0.01 0.04"/>
                </geometry>
                <material name="green">
                    <color rgba="0.1 0.8 0.2 1"/>
                </material>
            </visual>
            <collision>
                <geometry>
                    <box size="0.12 0.01 0.04"/>
                </geometry>
            </collision>
            <inertial>
                <mass value="0.1"/>
                <inertia ixx="0.001" ixy="0" ixz="0"
                         iyy="0.001" iyz="0" izz="0.001"/>
            </inertial>
        </link>

        <joint name="right_finger_joint" type="prismatic">
            <parent link="gripper_palm"/>
            <child link="right_finger"/>
            <origin xyz="0.06 -0.01 0"/>
            <axis xyz="0 -1 0"/>
            <limit lower="0"
                   upper="${(gripper_span - 0.02)/2}"
                   effort="20"
                   velocity="0.1"/>
        </joint>
        
        <link name="right_finger">
            <visual>
                <geometry>
                    <box size="0.12 0.01 0.04"/>
                </geometry>
                <material name="green">
                    <color rgba="0.1 0.8 0.2 1"/>
                </material>
            </visual>
            <collision>
                <geometry>
                    <box size="0.12 0.01 0.04"/>
                </geometry>
            </collision>
            <inertial>
                <mass value="0.1"/>
                <inertia ixx="0.001" ixy="0" ixz="0"
                         iyy="0.001" iyz="0" izz="0.001"/>
            </inertial>
        </link>

    </xacro:macro>

</robot>
